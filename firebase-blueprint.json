{
  "entities": {
    "Staff": {
      "title": "Staff",
      "description": "Cán bộ công an phụ trách địa bàn và nhiệm vụ",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "email": { "type": "string", "maxLength": 100 },
        "assignedGroups": { "type": "array" }
      },
      "required": ["id", "name", "role"]
    },
    "Account": {
      "title": "Account",
      "description": "Tài khoản đăng nhập hệ thống",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string", "maxLength": 50 },
        "password": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["admin", "staff"] },
        "staffId": { "type": "string" },
        "fullName": { "type": "string", "maxLength": 100 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "username", "role", "fullName"]
    },
    "TaskCategory": {
      "title": "TaskCategory",
      "description": "Danh mục nhiệm vụ công tác",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "key": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 150 },
        "shortName": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 500 },
        "icon": { "type": "string", "maxLength": 50 },
        "isSystem": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "key", "name"]
    },
    "ResidentialGroup": {
      "title": "ResidentialGroup",
      "description": "Tổ dân phố / Khu dân cư địa bàn",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "code": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 500 },
        "assignedStaffId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "HkcchRecord": {
      "title": "HkcchRecord",
      "description": "Hồ sơ Hộ không chủ hộ",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "hoTen": { "type": "string", "maxLength": 150 },
        "info1": { "type": "string", "maxLength": 150 },
        "toDanPho": { "type": "string", "maxLength": 150 },
        "staffId": { "type": "string" },
        "staffName": { "type": "string", "maxLength": 100 },
        "isDone": { "type": "boolean" },
        "note": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "hoTen", "staffId", "isDone"]
    },
    "MatuyRecord": {
      "title": "MatuyRecord",
      "description": "Hồ sơ Test ma túy",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "hoTen": { "type": "string", "maxLength": 150 },
        "namSinh": { "type": "string", "maxLength": 20 },
        "cmnd": { "type": "string", "maxLength": 50 },
        "info1": { "type": "string", "maxLength": 200 },
        "toDanPho": { "type": "string", "maxLength": 150 },
        "staffId": { "type": "string" },
        "staffName": { "type": "string", "maxLength": 100 },
        "isDone": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "hoTen", "staffId", "isDone"]
    },
    "DcttpRecord": {
      "title": "DcttpRecord",
      "description": "Hồ sơ Điều chỉnh Tổ dân phố",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "hoTen": { "type": "string", "maxLength": 150 },
        "info1": { "type": "number" },
        "toDanPho": { "type": "string", "maxLength": 150 },
        "staffId": { "type": "string" },
        "staffName": { "type": "string", "maxLength": 100 },
        "isDone": { "type": "boolean" },
        "note": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "hoTen", "staffId", "isDone"]
    },
    "DatdaiRecord": {
      "title": "DatdaiRecord",
      "description": "Hồ sơ Làm sạch dữ liệu đất đai",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chuHo": { "type": "string", "maxLength": 150 },
        "cmnd": { "type": "string", "maxLength": 50 },
        "namSinh": { "type": "string", "maxLength": 20 },
        "diaChi": { "type": "string", "maxLength": 255 },
        "toDanPho": { "type": "string", "maxLength": 150 },
        "staffId": { "type": "string" },
        "staffName": { "type": "string", "maxLength": 100 },
        "isDone": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "chuHo", "staffId", "isDone"]
    }
  },
  "firestore": {
    "/staff/{staffId}": {
      "schema": "Staff",
      "description": "Danh sách cán bộ phụ trách"
    },
    "/accounts/{accountId}": {
      "schema": "Account",
      "description": "Danh sách tài khoản hệ thống"
    },
    "/taskCategories/{categoryId}": {
      "schema": "TaskCategory",
      "description": "Danh mục nhiệm vụ"
    },
    "/residentialGroups/{groupId}": {
      "schema": "ResidentialGroup",
      "description": "Danh sách Tổ dân phố"
    },
    "/hkcch/{recordId}": {
      "schema": "HkcchRecord",
      "description": "Chỉ tiêu Hộ không chủ hộ"
    },
    "/matuy/{recordId}": {
      "schema": "MatuyRecord",
      "description": "Chỉ tiêu Test ma túy"
    },
    "/dcttp/{recordId}": {
      "schema": "DcttpRecord",
      "description": "Chỉ tiêu Điều chỉnh Tổ dân phố"
    },
    "/datdai/{recordId}": {
      "schema": "DatdaiRecord",
      "description": "Chỉ tiêu Làm sạch đất đai"
    },
    "/app_state/{docId}": {
      "schema": "object",
      "description": "Dữ liệu cấu hình hoặc trạng thái ứng dụng"
    }
  }
}
